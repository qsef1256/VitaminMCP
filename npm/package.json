{
  "name": "vitaminmcp",
  "version": "3.0.1",
  "mcpName": "io.github.Backas03/vitaminmcp",
  "description": "MCP server for testing Minecraft plugins: drives a real Paper server and real protocol bots from an AI agent.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "minecraft",
    "paper",
    "purpur",
    "bukkit",
    "plugin-testing",
    "end-to-end-testing"
  ],
  "homepage": "https://github.com/Backas03/VitaminMCP#readme",
  "bugs": "https://github.com/Backas03/VitaminMCP/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Backas03/VitaminMCP.git",
    "directory": "npm"
  },
  "license": "MIT",
  "author": "Backas03",
  "type": "module",
  "dependencies": {
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "2.4.5",
    "prismarine-auth": "^3.1.1"
  },
  "bin": {
    "vitaminmcp": "bin/vitaminmcp.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "bin",
    "lib",
    "runner",
    "checksums.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "stamp": "node scripts/stamp-checksums.mjs",
    "stage-runner": "node scripts/stage-node-runner.mjs",
    "prepublishOnly": "node scripts/stage-node-runner.mjs && node scripts/stamp-checksums.mjs --verify"
  }
}
